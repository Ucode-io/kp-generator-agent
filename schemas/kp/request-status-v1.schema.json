{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udevs.local/schemas/kp/request-status-v1.schema.json",
  "title": "KP RequestStatus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "state", "stage", "progress", "updatedAt", "failure"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "pattern": "^KP-[0-9]{8}-[A-Z0-9]{6,32}$" },
    "state": { "enum": ["created", "collecting", "planning", "rendering", "qa", "promoting", "ready", "failed", "cancelled"] },
    "stage": { "type": "string", "minLength": 1, "maxLength": 80 },
    "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "stage", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
