{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udevs.local/schemas/kp/app-prototype-record-v1.schema.json",
  "title": "KP AppPrototypeRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "publicId", "publicUrl", "rendererVersion", "relativePath", "sha256", "sizeBytes", "screenCount", "qaStatus", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "publicId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "publicUrl": { "type": "string", "format": "uri" },
    "rendererVersion": { "type": "string", "minLength": 1 },
    "relativePath": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "screenCount": { "type": "integer", "minimum": 48, "maximum": 60 },
    "qaStatus": { "enum": ["PASS", "WARN", "FAIL"] },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
