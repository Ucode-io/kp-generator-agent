{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udevs.local/schemas/kp/reference-analysis-v1.schema.json",
  "title": "KP ReferenceAnalysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "referenceId", "captureId", "role", "status", "analyzerMode", "sampledPages", "frameIds", "confidence", "aspectConfidence", "palette", "typography", "layout", "components", "diagramGrammar", "pageSilhouettes", "imagery", "doUse", "doNotUse", "evidence", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "analysisId": { "type": "string", "pattern": "^RAN-[A-Za-z0-9._-]+$" },
    "referenceId": { "type": "string", "pattern": "^REF-[A-Za-z0-9._-]+$" },
    "captureId": { "type": "string", "pattern": "^RCAP-[A-Za-z0-9._-]+$" },
    "role": { "enum": ["brand_system", "visual_style", "product_analog", "logo_asset", "content_evidence", "data_source", "unknown"] },
    "status": { "enum": ["complete", "partial", "blocked", "failed"] },
    "analyzerMode": { "enum": ["vision_plus_deterministic", "deterministic", "asset_metadata"] },
    "provider": { "type": ["string", "null"], "maxLength": 80 },
    "model": { "type": ["string", "null"], "maxLength": 120 },
    "analyzerVersion": { "type": ["string", "null"], "maxLength": 80 },
    "promptVersion": { "type": ["string", "null"], "maxLength": 80 },
    "timeoutMs": { "type": ["integer", "null"], "minimum": 0 },
    "sampledPages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "frameIds": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "aspectConfidence": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "foreground", "accents", "semanticRoles"],
      "properties": {
        "background": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "foreground": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "accents": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "semanticRoles": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayClass", "bodyClass", "metadataClass", "displayWeight", "headingCase", "scale", "observedFamilies", "safeFallbackFamilies"],
      "properties": {
        "displayClass": { "enum": ["neo_grotesk_sans", "humanist_sans", "geometric_sans", "transitional_serif", "display_serif", "monospace", "mixed", "unknown"] },
        "bodyClass": { "enum": ["neo_grotesk_sans", "humanist_sans", "geometric_sans", "transitional_serif", "display_serif", "monospace", "mixed", "unknown"] },
        "metadataClass": { "enum": ["neo_grotesk_sans", "humanist_sans", "geometric_sans", "transitional_serif", "display_serif", "monospace", "mixed", "unknown"] },
        "displayWeight": { "type": "integer", "minimum": 100, "maximum": 950 },
        "headingCase": { "enum": ["sentence", "title", "upper", "lower", "mixed"] },
        "scale": { "enum": ["compact", "balanced", "large_editorial", "oversized"] },
        "observedFamilies": { "type": "array", "items": { "type": "string" } },
        "safeFallbackFamilies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "density", "alignment", "gridColumns", "outerMarginRatio", "whitespaceRatio", "dominantCompositions"],
      "properties": {
        "aspectRatio": { "type": "number", "minimum": 0.5, "maximum": 3 },
        "density": { "enum": ["sparse", "restrained", "balanced", "dense"] },
        "alignment": { "enum": ["left_editorial", "centered", "symmetric_grid", "asymmetric_grid", "mixed"] },
        "gridColumns": { "type": "integer", "minimum": 1, "maximum": 24 },
        "outerMarginRatio": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "whitespaceRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "dominantCompositions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": { "type": "object", "additionalProperties": true },
    "diagramGrammar": { "type": "object", "additionalProperties": true },
    "pageSilhouettes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "treatment", "photographyAllowed"],
      "properties": {
        "mode": { "enum": ["none", "photography", "illustration", "abstract_static", "texture", "mixed"] },
        "treatment": { "type": "string" },
        "photographyAllowed": { "type": "boolean" }
      }
    },
    "doUse": { "type": "array", "items": { "type": "string" } },
    "doNotUse": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
