{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udevs.local/schemas/kp/visual-style-profile-v1.schema.json",
  "title": "KP VisualStyleProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "status", "referenceIds", "confidence", "canvas", "accents", "typography", "layout", "components", "diagramGrammar", "provenance", "fallbackFields", "conflicts", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profileId": { "type": "string", "pattern": "^VSP-[A-Za-z0-9._-]+$" },
    "status": { "enum": ["reference_driven", "fallback_partial", "fallback_default", "failed"] },
    "referenceIds": { "type": "array", "items": { "type": "string", "pattern": "^REF-[A-Za-z0-9._-]+$" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "canvas": { "type": "object", "additionalProperties": { "type": "string" } },
    "accents": { "type": "object", "additionalProperties": { "type": "string" } },
    "typography": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "array", "object", "null"] } },
    "layout": { "type": "object", "additionalProperties": true },
    "components": { "type": "object", "additionalProperties": true },
    "diagramGrammar": { "type": "object", "additionalProperties": true },
    "provenance": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "fallbackFields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
