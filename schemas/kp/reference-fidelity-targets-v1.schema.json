{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udevs.local/schemas/kp/reference-fidelity-targets-v1.schema.json",
  "title": "KP ReferenceFidelityTargets v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "requestId", "referenceMode", "primaryReferenceId", "thresholds", "requiredLayoutFamilies", "requiredTokens", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "targetId": { "type": "string", "pattern": "^RFT-[A-Za-z0-9._-]+$" },
    "requestId": { "type": "string", "minLength": 1 },
    "referenceMode": { "enum": ["explicit_full", "explicit_partial"] },
    "primaryReferenceId": { "type": ["string", "null"], "pattern": "^REF-[A-Za-z0-9._-]+$" },
    "primaryReferenceRole": {
      "enum": ["brand_system", "visual_style", "product_analog", "logo_asset", "content_evidence", "data_source", "unknown", null]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "requiredLayoutFamilies": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "requiredTokens": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket", "name", "value"],
        "properties": {
          "bucket": { "enum": ["canvas", "accents", "typography", "layout", "components", "diagramGrammar"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "sourceFrameIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "layout", "typography", "tone", "density", "geometry", "imagery"],
      "properties": {
        "palette": { "$ref": "#/$defs/dimension" },
        "layout": { "$ref": "#/$defs/dimension" },
        "typography": { "$ref": "#/$defs/dimension" },
        "tone": { "$ref": "#/$defs/dimension" },
        "density": { "$ref": "#/$defs/dimension" },
        "geometry": { "$ref": "#/$defs/dimension" },
        "imagery": { "$ref": "#/$defs/dimension" }
      }
    },
    "applicableDimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["palette", "layout", "typography", "tone", "density", "geometry", "imagery"] }
    },
    "constraints": { "type": "object", "additionalProperties": true },
    "targetHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "dimension": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  }
}
