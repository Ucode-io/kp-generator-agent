# AI provider key. Existing deployments may keep an Anthropic sk-ant-* key in
# this historical variable; palette provider=auto detects it.
OPENAI_API_KEY=
# Canonical Anthropic variable is also supported and takes precedence.
ANTHROPIC_API_KEY=

# Optional HTTP bearer key. Leave empty for local-only development.
KP_AGENT_API_KEY=
KP_AGENT_HOST=127.0.0.1
KP_AGENT_PORT=8787
KP_AGENT_MAX_BODY_BYTES=26214400

# Renderer defaults. Keep these values for production-quality PDFs.
KP_PDF_RENDERER_MODE=v5
KP_PDF_ENABLE_V5_PRODUCTION=1
KP_PDF_POLICY_GENERATION=2
KP_PDF_ROLLOUT_EPOCH=STANDALONE-KP-AGENT
KP_PDF_EXPECTED_PAGES=0
KP_PDF_EXPECTED_RATIO=1.5
KP_PDF_QUALITY_GATE_MODE=enforce
KP_PDF_DISABLE_REFERENCED_GENERATION=0
KP_DISABLE_WEB_RESEARCH=1
KP_REFERENCE_VISION_PROVIDER=openai
KP_REFERENCE_VISION_MODEL=gpt-4.1-mini
# 0 = fixed Udevs screenshot palette/background for every proposal.
# 1 = detect and apply the website palette from the prompt.
KP_DYNAMIC_COLOR_PALETTES_ENABLED=0
# Optional AI adjudication of website palette candidates. The model can only
# choose colors already extracted from the site's DOM/CSS/logo.
KP_REFERENCE_PALETTE_AI_ENABLED=1
# auto detects sk-ant-* as Anthropic; otherwise OpenAI is used.
KP_REFERENCE_PALETTE_AI_PROVIDER=auto
# Empty selects a provider-specific default model.
KP_REFERENCE_PALETTE_AI_MODEL=
KP_REFERENCE_PALETTE_AI_MIN_CONFIDENCE=0.55
KP_REFERENCE_PALETTE_AI_TIMEOUT_MS=20000
KP_REFERENCE_PALETTE_AI_MAX_TOKENS=450
# If live extraction is blocked, allow the model to identify colors from the
# public domain/brand identity. The result is marked as ai_domain_fallback.
KP_REFERENCE_PALETTE_AI_DOMAIN_MIN_CONFIDENCE=0.55
KP_REFERENCE_PALETTE_AI_DOMAIN_TIMEOUT_MS=20000
KP_REFERENCE_THEME_TIMEOUT_MS=12000
KP_REFERENCE_THEME_SETTLE_MS=1500
# Optional local Chrome/Chromium path when Playwright browsers are not installed.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
CODEX_PYTHON=python3
