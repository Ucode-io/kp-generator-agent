# Required only when a UI/reference image must be analyzed.
OPENAI_API_KEY=

# Optional HTTP bearer key. Leave empty for local-only development.
KP_AGENT_API_KEY=
KP_AGENT_HOST=127.0.0.1
KP_AGENT_PORT=8787
KP_AGENT_MAX_BODY_BYTES=26214400

# Renderer defaults. Keep these values for production-quality PDFs.
KP_PDF_RENDERER_MODE=v5
KP_PDF_ENABLE_V5_PRODUCTION=1
KP_PDF_POLICY_GENERATION=2
KP_PDF_ROLLOUT_EPOCH=STANDALONE-KP-AGENT
KP_PDF_EXPECTED_PAGES=0
KP_PDF_EXPECTED_RATIO=1.5
KP_PDF_QUALITY_GATE_MODE=enforce
KP_PDF_DISABLE_REFERENCED_GENERATION=0
KP_DISABLE_WEB_RESEARCH=1
KP_REFERENCE_VISION_PROVIDER=openai
KP_REFERENCE_VISION_MODEL=gpt-4.1-mini
CODEX_PYTHON=python3
